<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                     x:Class="CPMCD.Dotvanta.Component.Resources.Styles.Colors">

    <!--
        Consuming app apne App.xaml mein isko merge kare:
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="{x:Static comp:ColorsSource.Uri}" />
        </ResourceDictionary.MergedDictionaries>
        Ya seedha: new ResourceDictionary { Source = ... } — README mein detail hai.
        Neeche AppThemeBinding automatically Light/Dark switch karta hai (system theme follow karta hai).
    -->

    <Color x:Key="CpmcdPrimaryLight">#4A6CF7</Color>
    <Color x:Key="CpmcdPrimaryDark">#7C93FF</Color>

    <Color x:Key="CpmcdBackgroundLight">#FFFFFF</Color>
    <Color x:Key="CpmcdBackgroundDark">#121212</Color>

    <Color x:Key="CpmcdSurfaceLight">#F5F6FA</Color>
    <Color x:Key="CpmcdSurfaceDark">#1E1E1E</Color>

    <Color x:Key="CpmcdTextLight">#1A1A1A</Color>
    <Color x:Key="CpmcdTextDark">#EAEAEA</Color>

    <Color x:Key="CpmcdPlaceholderLight">#9A9A9A</Color>
    <Color x:Key="CpmcdPlaceholderDark">#8A8A8A</Color>

    <Color x:Key="CpmcdBorderLight">#D9D9D9</Color>
    <Color x:Key="CpmcdBorderDark">#3A3A3A</Color>

    <Color x:Key="CpmcdErrorLight">#E5484D</Color>
    <Color x:Key="CpmcdErrorDark">#FF6B6E</Color>

    <Color x:Key="CpmcdOverlayLight">#66000000</Color>
    <Color x:Key="CpmcdOverlayDark">#99000000</Color>

</ResourceDictionary>
