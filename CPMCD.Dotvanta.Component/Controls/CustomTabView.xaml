<?xml version="1.0" encoding="UTF-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CPMCD.Dotvanta.Component.Controls.CustomTabView"
             x:Name="Root">

    <Grid RowDefinitions="Auto,*" ColumnDefinitions="Auto,*"
          x:Name="LayoutRoot">

        <!-- Horizontal mode: tab strip Row 0, content Row 1 -->
        <!-- Vertical mode: tab strip Col 0, content Col 1 -->
        <ScrollView x:Name="TabStripScroll"
                    Grid.Row="0" Grid.Column="0"
                    Orientation="Horizontal">
            <FlexLayout x:Name="TabStrip"
                        Direction="Row"
                        JustifyContent="Start"
                        AlignItems="Center" />
        </ScrollView>

        <ContentView x:Name="TabContentHost"
                     Grid.Row="1" Grid.Column="1" />

    </Grid>

</ContentView>
